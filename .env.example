# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=wallet_db

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# AWS KMS
AWS_REGION=ap-northeast-1
AWS_KMS_KEY_ID=arn:aws:kms:ap-northeast-1:123456789:key/your-key-id
# AWS credentials via IAM role (recommended on EC2/ECS)
# or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for local dev

# Ethereum
ETH_WS_URL=ws://your-node:8546
# BIP39 mnemonic for HD wallet derivation (12 or 24 words). Keep this secret.
# Generate with: node -e "const {ethers}=require('ethers'); console.log(ethers.Wallet.createRandom().mnemonic.phrase)"
WALLET_MASTER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12